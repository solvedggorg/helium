---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={["nametag", className]} aria-hidden="true">
  <span class="clip"></span>
  <span class="plate">
    <span class="hello">hello, my name is</span>
    <span class="who">BOB</span>
  </span>
</div>

<style>
  .nametag {
    position: relative;
    width: min(22rem, 86vw);
    filter: drop-shadow(0 18px 24px rgb(20 32 31 / 0.28));
    animation: settle 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .clip {
    display: block;
    width: 2.4rem;
    height: 1.7rem;
    margin: 0 auto -0.45rem;
    background: linear-gradient(180deg, #e7eeed 0%, #8f9c9a 55%, #c5d0ce 100%);
    border-radius: 0.2rem 0.2rem 0.15rem 0.15rem;
    box-shadow: inset 0 1px 0 #fff;
  }

  .clip::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 1.15rem;
    width: 1.15rem;
    height: 0.7rem;
    transform: translateX(-50%);
    border: 2px solid #6d7a78;
    border-top: 0;
    border-radius: 0 0 0.35rem 0.35rem;
  }

  .plate {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 1.2rem 0.7rem;
    background: radial-gradient(120% 80% at 20% 0%, #ff6a55 0%, var(--badge) 42%, #b42218 100%);
    border-radius: 0.7rem;
    border: 3px solid #f7d4cf;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 -8px 16px rgb(90 10 8 / 0.25);
  }

  .hello {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 248 240 / 0.86);
  }

  .who {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.4rem, 16vw, 7.2rem);
    line-height: 0.82;
    letter-spacing: 0.04em;
    color: #fff8f0;
    text-shadow: 0 2px 0 rgb(110 14 10 / 0.45);
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(-1.4rem) rotate(-10deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(-6deg);
    }
  }
</style>
