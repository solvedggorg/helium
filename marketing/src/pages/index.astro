---
import Layout from "@/layouts/main.astro"
import Nametag from "@/components/Nametag.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"

const release = "https://github.com/solvedggorg/helium/releases"
const source = "https://github.com/solvedggorg/helium"
const services = "https://services1.iresolvedllc.com"

const changes = [
  {
    ticket: "HOST",
    title: "Our services",
    body: "Extension updates and uBlock lists come from services1.iresolvedllc.com. The proxy bases are /ext and /ubo/. Same Helium services shape, our host.",
  },
  {
    ticket: "PORT",
    title: "Agent port",
    body: "Bob speaks MCP on 127.0.0.1:17321 from inside the browser process. No second profile, no Node sidecar, no extra RAM just to keep the agent attached.",
  },
  {
    ticket: "FLAKE",
    title: "Nix first",
    body: "A flake and a callPackage derivation live in the repo. Add github:solvedggorg/helium to a NixOS config and install pkgs.helium.",
  },
]

const kept = [
  "ungoogled-chromium",
  "uBlock Origin",
  "no Google services",
  "no extra browser",
]
---

<Layout>
  <div class="page">
    <div class="rail" aria-hidden="true"></div>
    <div class="sheet">
      <SiteHeader />

      <main id="content">
      <section class="hero">
        <Nametag />
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="struck">Helium</span>
            <span class="stamp">BOB</span>
          </p>
          <h1>The Helium fork we actually run.</h1>
          <p class="lede">
            Privacy-first Chromium. Unbiased blocking. No Google services.
            Bob keeps that, then points services at our host and leaves an
            agent socket in the daily window.
          </p>
          <div class="actions">
            <a class="btn btn-badge" href="/#download">Get Linux</a>
            <a class="btn btn-steel" href={source} rel="noreferrer" target="_blank">Source</a>
          </div>
        </div>
      </section>

      <section id="changed" class="block">
        <h2>What changed</h2>
        <p class="intro">
          Helium already did the hard privacy work. Bob is the name on the
          badge and the three wires we added.
        </p>
        <ul class="tickets">
          {
            changes.map((item) => (
              <li>
                <span class="ticket-no">{item.ticket}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="download" class="block">
        <h2>Download</h2>
        <p class="intro">
          Linux AppImages ship from GitHub Releases. macOS and Windows are
          source builds for now.
        </p>
        <div class="dl-row">
          <a class="btn btn-badge" href={release} rel="noreferrer" target="_blank">Linux AppImage</a>
          <a class="btn btn-steel" href={`${source}/tree/main/nix`} rel="noreferrer" target="_blank">Nix flake</a>
        </div>
        <pre class="cmd"><code>nix profile install github:solvedggorg/helium</code></pre>
      </section>

      <section id="agents" class="block">
        <h2>Agents</h2>
        <p class="intro">
          Point a local MCP client at Bob. The server is loopback only.
        </p>
        <dl class="spec">
          <div>
            <dt>MCP</dt>
            <dd><code>http://127.0.0.1:17321/mcp</code></dd>
          </div>
          <div>
            <dt>Services</dt>
            <dd>
              <a href={services} rel="noreferrer" target="_blank">{services.replace("https://", "")}</a>
              <span> · /ext · /ubo/</span>
            </dd>
          </div>
        </dl>
        <pre class="cmd"><code
          >{`curl -sS -m 8 \\
  -H 'Accept: application/json, text/event-stream' \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"helium_status","arguments":{}}}' \\
  http://127.0.0.1:17321/mcp`}</code></pre>
      </section>

      <section class="block kept">
        <h2>Still Helium</h2>
        <p class="intro">
          Bob is a fork, not a rewrite. The privacy work stays. We changed the
          name on the badge and three wires.
        </p>
        <ul class="chips">
          {kept.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      </main>

      <SiteFooter />
    </div>
  </div>
</Layout>

<style>
  .page {
    min-height: 100svh;
    background:
      radial-gradient(80% 50% at 10% 0%, rgb(255 255 255 / 0.05), transparent 50%),
      repeating-linear-gradient(
        135deg,
        rgb(255 255 255 / 0.03) 0 2px,
        transparent 2px 7px
      ),
      var(--formica);
    color: var(--counter);
  }

  .rail {
    position: sticky;
    top: 0;
    height: 0.55rem;
    background: linear-gradient(90deg, #8a9694, var(--chrome), #6f7b79);
    box-shadow: 0 1px 0 #4c5756;
  }

  .sheet {
    width: min(68rem, calc(100% - 2rem));
    margin: 1.2rem auto 2.5rem;
    padding: 0.4rem 1.4rem 0;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.35), transparent 8rem),
      var(--counter);
    color: var(--ink);
    border: 1px solid rgb(20 32 31 / 0.18);
    box-shadow:
      0 30px 50px rgb(8 16 15 / 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.55);
  }

  .hero {
    display: grid;
    gap: 2rem;
    padding: 1.5rem 0 3rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .hero {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: 3rem;
      padding-top: 2.2rem;
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .struck {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    color: var(--muted-foreground);
  }

  .stamp {
    background: var(--ticket);
    color: var(--ink);
    padding: 0.1rem 0.4rem;
    transform: rotate(-2deg);
    font-weight: 500;
    box-shadow: 0 1px 0 rgb(20 32 31 / 0.15);
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 0.92;
  }

  .lede,
  .intro {
    max-width: 38rem;
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .lede {
    margin: 1rem 0 1.4rem;
  }

  .actions,
  .dl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.45rem 1rem 0.35rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 0.2rem;
  }

  .btn-badge {
    background: var(--badge);
    color: #fff8f0;
  }

  .btn-badge:hover {
    filter: brightness(1.05);
  }

  .btn-steel {
    background: var(--formica);
    color: var(--counter);
  }

  .btn-steel:hover {
    filter: brightness(1.08);
  }

  .block {
    padding: 2.4rem 0 0.4rem;
    border-top: 1px dashed color-mix(in oklab, var(--ink) 22%, transparent);
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .intro {
    margin: 0 0 1.4rem;
  }

  .tickets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 760px) {
    .tickets {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tickets li {
    background: var(--ticket);
    color: var(--ink);
    padding: 1rem 1rem 1.1rem;
    box-shadow: 0 1px 0 rgb(20 32 31 / 0.12);
    transform: rotate(-0.4deg);
  }

  .tickets li:nth-child(2) {
    transform: rotate(0.6deg);
  }

  .tickets li:nth-child(3) {
    transform: rotate(-0.2deg);
  }

  .ticket-no {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .tickets h3 {
    margin: 0.35rem 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 800;
  }

  .tickets p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .kept {
    padding-bottom: 2rem;
  }

  .chips li {
    padding: 0.35rem 0.65rem 0.3rem;
    border: 1px solid color-mix(in oklab, var(--ink) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .spec {
    display: grid;
    gap: 0.8rem;
    margin: 0 0 1rem;
  }

  .spec div {
    display: grid;
    gap: 0.2rem;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  dd {
    margin: 0;
  }

  .cmd {
    overflow-x: auto;
    padding: 0.9rem 1rem;
    background: var(--formica);
    color: var(--counter);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    border-radius: 0.15rem;
  }

  .cmd code {
    font-family: inherit;
  }
</style>
