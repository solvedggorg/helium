+void DispatchMcpOnUI(std::string body, Reply reply) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(body);
+  if (!parsed || !parsed->is_dict()) {
+    std::move(reply).Run(RpcError(base::Value(), -32700, "parse error"));
+    return;
+  }
+  const base::Value::Dict& req = parsed->GetDict();
+  const std::string* method = req.FindString("method");
+  const base::Value* id = req.Find("id");
+  const base::Value empty_id;
+  const base::Value& rpc_id = id ? *id : empty_id;
+  if (!method) {
+    std::move(reply).Run(RpcError(rpc_id, -32600, "missing method"));
+    return;
+  }
+  if (*method == "notifications/initialized" ||
+      *method == "notifications/cancelled") {
+    std::move(reply).Run(base::Value::Dict());
+    return;
+  }
+  if (*method == "initialize") {
+    std::string version = "2024-11-05";
+    if (const base::Value::Dict* params = req.FindDict("params")) {
+      if (const std::string* pv = params->FindString("protocolVersion")) {
+        version = *pv;
+      }
+    }
+    base::Value::Dict caps;
+    caps.Set("tools", base::Value::Dict());
+    base::Value::Dict info;
+    info.Set("name", "helium-devtools");
+    info.Set("version", "0.1.0");
+    base::Value::Dict result;
+    result.Set("protocolVersion", version);
+    result.Set("capabilities", std::move(caps));
+    result.Set("serverInfo", std::move(info));
+    std::move(reply).Run(RpcResult(rpc_id, std::move(result)));
+    return;
+  }
+  if (*method == "ping") {
+    std::move(reply).Run(RpcResult(rpc_id, base::Value::Dict()));
+    return;
+  }
+  if (*method == "tools/list") {
+    base::Value::Dict result;
+    result.Set("tools", ToolList());
+    std::move(reply).Run(RpcResult(rpc_id, std::move(result)));
+    return;
+  }
+  if (*method == "tools/call") {
+    const base::Value::Dict* params = req.FindDict("params");
+    const std::string* name = params ? params->FindString("name") : nullptr;
+    if (!name) {
+      std::move(reply).Run(RpcError(rpc_id, -32602, "missing tool name"));
+      return;
+    }
+    const base::Value::Dict* args = params->FindDict("arguments");
+    static const base::Value::Dict kEmptyArgs;
+    CallTool(*name, args ? *args : kEmptyArgs, rpc_id, std::move(reply));
+    return;
+  }
+  std::move(reply).Run(RpcError(rpc_id, -32601, "method not found"));
+}
