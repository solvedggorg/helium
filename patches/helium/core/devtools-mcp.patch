+class HeliumEvalClient : public content::DevToolsAgentHostClient {
+ public:
+  HeliumEvalClient(scoped_refptr<content::DevToolsAgentHost> host,
+                   base::OnceCallback<void(base::Value)> done)
+      : host_(std::move(host)), done_(std::move(done)) {}
+
+  bool Start(const std::string& message) {
+    if (!host_ || !host_->AttachClient(this)) {
+      if (done_) {
+        base::Value::Dict err;
+        err.Set("error", "attach_refused: restricted_url");
+        std::move(done_).Run(base::Value(std::move(err)));
+      }
+      return false;
+    }
+    host_->DispatchProtocolMessage(this, base::as_byte_span(message));
+    return true;
+  }
+
+  bool MayAttachToURL(const GURL& url, bool is_webui) override {
+    return !is_webui && !IsRestrictedUrl(url);
+  }
+  bool AllowUnsafeOperations() override { return true; }
+  std::string GetTypeForMetrics() override { return "Other"; }
+
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override {
+    std::string_view json(reinterpret_cast<const char*>(message.data()),
+                          message.size());
+    std::optional<base::Value> parsed = base::JSONReader::Read(json);
+    Finish(parsed ? std::move(*parsed) : base::Value());
+  }
+
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override {
+    Finish(base::Value());
+  }
+
+ private:
+  void Finish(base::Value value) {
+    if (host_) {
+      host_->DetachClient(this);
+      host_.reset();
+    }
+    if (done_) {
+      std::move(done_).Run(std::move(value));
+    }
+    delete this;
+  }
+
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  base::OnceCallback<void(base::Value)> done_;
+};
+
+void DispatchCdp(content::WebContents* contents,
+                 const std::string& method,
+                 base::Value::Dict params,
+                 base::OnceCallback<void(base::Value)> done) {
+  auto host = content::DevToolsAgentHost::GetOrCreateFor(contents);
+  base::Value::Dict msg;
+  msg.Set("id", 1);
+  msg.Set("method", method);
+  msg.Set("params", std::move(params));
+  auto* client =
+      new HeliumEvalClient(std::move(host), std::move(done));
+  if (!client->Start(WriteJson(base::Value(std::move(msg))))) {
+    delete client;
+  }
+}
+
+base::Value ParseEvalResult(const base::Value& cdp) {
+  if (!cdp.is_dict()) {
+    return base::Value(ToolError("eval_failed: empty CDP result"));
+  }
+  const base::Value::Dict& dict = cdp.GetDict();
+  if (const std::string* err = dict.FindString("error")) {
+    return base::Value(ToolError(*err));
+  }
+  const base::Value::Dict* error = dict.FindDict("error");
+  if (error) {
+    const std::string* message = error->FindString("message");
+    return base::Value(ToolError(message ? *message : "eval_failed"));
+  }
+  const base::Value::Dict* result_wrap = dict.FindDict("result");
+  if (!result_wrap) {
+    return base::Value(
+        ToolError("eval_failed: missing Runtime.evaluate result"));
+  }
+  const base::Value::Dict* details = result_wrap->FindDict("exceptionDetails");
+  if (details) {
+    const base::Value::Dict* exc = details->FindDict("exception");
+    if (exc) {
+      if (const std::string* desc = exc->FindString("description")) {
+        return base::Value(ToolError(
+            base::StringPrintf("eval_failed: %s", desc->c_str())));
+      }
+    }
+    const std::string* text = details->FindString("text");
+    return base::Value(ToolError(base::StringPrintf(
+        "eval_failed: %s", text ? text->c_str() : "eval exception")));
+  }
+  const base::Value::Dict* remote = result_wrap->FindDict("result");
+  if (!remote) {
+    return base::Value(
+        ToolError("eval_failed: missing Runtime.evaluate result"));
+  }
+  base::Value::Dict out;
+  if (const std::string* type = remote->FindString("type")) {
+    out.Set("type", *type);
+  }
+  if (const base::Value* value = remote->Find("value")) {
+    out.Set("result", value->Clone());
+  } else {
+    out.Set("result", base::Value());
+  }
+  return base::Value(ToolContent(base::Value(std::move(out))));
+}
+
+using Reply = base::OnceCallback<void(base::Value::Dict)>;
+
+void ReplyTool(Reply reply, const base::Value& id, base::Value::Dict payload) {
+  std::move(reply).Run(RpcResult(id, std::move(payload)));
+}
+
+void HandleEval(int tab_id,
+                const std::string& expression,
+                const base::Value& id,
+                Reply reply) {
+  std::optional<TabRef> tab = FindTab(tab_id);
+  if (!tab) {
+    ReplyTool(std::move(reply), id, ToolError("unknown tab"));
+    return;
+  }
+  if (IsRestrictedUrl(tab->contents->GetLastCommittedURL())) {
+    ReplyTool(std::move(reply), id, ToolError("attach_refused: restricted_url"));
+    return;
+  }
+  base::Value::Dict params;
+  params.Set("expression", expression);
+  params.Set("returnByValue", true);
+  params.Set("awaitPromise", true);
+  DispatchCdp(
+      tab->contents, "Runtime.evaluate", std::move(params),
+      base::BindOnce(
+          [](base::Value id, Reply reply, base::Value cdp) {
+            base::Value parsed = ParseEvalResult(cdp);
+            ReplyTool(std::move(reply), id, std::move(parsed).TakeDict());
+          },
+          id.Clone(), std::move(reply)));
+}
+
+void HandleCookies(const std::string& domain,
+                   const base::Value& id,
+                   Reply reply) {
+  Profile* profile = ActiveProfile();
+  if (!profile) {
+    ReplyTool(std::move(reply), id, ToolError("no_profile"));
+    return;
+  }
+  network::mojom::CookieManager* manager =
+      profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+  if (!manager) {
+    ReplyTool(std::move(reply), id, ToolError("no_cookie_manager"));
+    return;
+  }
+  manager->GetAllCookies(base::BindOnce(
+      [](std::string domain, base::Value id, Reply reply,
+         const std::vector<net::CanonicalCookie>& cookies) {
+        base::Value::List list;
+        for (const net::CanonicalCookie& cookie : cookies) {
+          std::string host = cookie.Domain();
+          if (base::StartsWith(host, ".")) {
+            host = host.substr(1);
+          }
+          if (host != domain && !base::EndsWith(host, "." + domain) &&
+              !base::EndsWith(domain, "." + host)) {
+            continue;
+          }
+          base::Value::Dict item;
+          item.Set("name", cookie.Name());
+          item.Set("value", cookie.Value());
+          item.Set("domain", cookie.Domain());
+          item.Set("path", cookie.Path());
+          item.Set("secure", cookie.SecureAttribute());
+          item.Set("httpOnly", cookie.IsHttpOnly());
+          list.Append(std::move(item));
+        }
+        base::Value::Dict payload;
+        payload.Set("cookies", std::move(list));
+        ReplyTool(std::move(reply), id,
+                  ToolContent(base::Value(std::move(payload))));
+      },
+      domain, id.Clone(), std::move(reply)));
+}
+
+void CallTool(const std::string& name,
+              const base::Value::Dict& args,
+              const base::Value& id,
+              Reply reply) {
+  if (name == "helium_status") {
+    base::Value::Dict listed = ListTabsPayload();
+    const base::Value::List* tabs = listed.FindList("tabs");
+    base::Value::Dict status;
+    status.Set("connected", true);
+    status.Set("tabs", tabs ? static_cast<int>(tabs->size()) : 0);
+    status.Set("attached", base::Value::List());
+    status.Set("lastError", "");
+    status.Set("inspectEnabled", false);
+    status.Set("remoteDebuggingPref", false);
+    status.Set("inspectUrl", "helium://inspect/#remote-debugging");
+    status.Set("attachPath", "in-process");
+    ReplyTool(std::move(reply), id, ToolContent(base::Value(std::move(status))));
+    return;
+  }
+
+  if (name == "helium_list_tabs" || name == "list_pages") {
+    ReplyTool(std::move(reply), id,
+              ToolContent(base::Value(ListTabsPayload())));
+    return;
+  }
+
+  if (name == "helium_new_tab") {
+    Profile* profile = ActiveProfile();
+    if (!profile) {
+      ReplyTool(std::move(reply), id, ToolError("no_profile"));
+      return;
+    }
+    std::string url = "about:blank";
+    if (const std::string* raw = args.FindString("url")) {
+      url = *raw;
+    }
+    NavigateParams params(profile, GURL(url), ui::PAGE_TRANSITION_FROM_API);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+    base::Value::Dict tab;
+    if (params.navigated_or_inserted_contents) {
+      tab = SerializeTab(params.navigated_or_inserted_contents, true);
+    }
+    base::Value::Dict payload;
+    payload.Set("tab", std::move(tab));
+    ReplyTool(std::move(reply), id,
+              ToolContent(base::Value(std::move(payload))));
+    return;
+  }
+
+  if (name == "select_page" || name == "helium_activate_tab") {
+    const std::optional<int> tab_id = args.FindInt("tabId");
+    if (!tab_id) {
+      ReplyTool(std::move(reply), id, ToolError("tabId required"));
+      return;
+    }
+    std::optional<TabRef> tab = FindTab(*tab_id);
+    if (!tab) {
+      ReplyTool(std::move(reply), id, ToolError("unknown tab"));
+      return;
+    }
+    tab->browser->tab_strip_model()->ActivateTabAt(tab->index);
+    if (tab->browser->window()) {
+      tab->browser->window()->Show();
+    }
+    ReplyTool(std::move(reply), id, ToolContent(base::Value(base::Value::Dict())));
+    return;
+  }
+
+  if (name == "navigate_page") {
+    const std::optional<int> tab_id = args.FindInt("tabId");
+    const std::string* url = args.FindString("url");
+    if (!tab_id || !url) {
+      ReplyTool(std::move(reply), id, ToolError("tabId and url required"));
+      return;
+    }
+    std::optional<TabRef> tab = FindTab(*tab_id);
+    if (!tab) {
+      ReplyTool(std::move(reply), id, ToolError("unknown tab"));
+      return;
+    }
+    tab->contents->GetController().LoadURL(GURL(*url), content::Referrer(),
+                                           ui::PAGE_TRANSITION_FROM_API,
+                                           std::string());
+    ReplyTool(std::move(reply), id,
+              ToolContent(base::Value(SerializeTab(tab->contents, true))));
+    return;
+  }
+
+  if (name == "helium_eval" || name == "evaluate_script") {
+    const std::optional<int> tab_id = args.FindInt("tabId");
+    const std::string* expression = args.FindString("expression");
+    if (!expression) {
+      expression = args.FindString("function");
+    }
+    if (!tab_id || !expression) {
+      ReplyTool(std::move(reply), id,
+                ToolError("tabId and expression required"));
+      return;
+    }
+    HandleEval(*tab_id, *expression, id, std::move(reply));
+    return;
+  }
+
+  if (name == "take_snapshot") {
+    const std::optional<int> tab_id = args.FindInt("tabId");
+    if (!tab_id) {
+      ReplyTool(std::move(reply), id, ToolError("tabId required"));
+      return;
+    }
+    HandleEval(*tab_id,
+               "document.documentElement ? "
+               "document.documentElement.outerHTML.slice(0, 80000) : ''",
+               id, std::move(reply));
+    return;
+  }
+
+  if (name == "helium_get_cookies") {
+    const std::string* domain = args.FindString("domain");
+    if (!domain) {
+      ReplyTool(std::move(reply), id, ToolError("domain required"));
+      return;
+    }
+    HandleCookies(*domain, id, std::move(reply));
+    return;
+  }
+
+  if (name == "helium_list_extensions") {
+    Profile* profile = ActiveProfile();
+    if (!profile) {
+      ReplyTool(std::move(reply), id, ToolError("no_profile"));
+      return;
+    }
+    auto* registry = extensions::ExtensionRegistry::Get(profile);
+    base::Value::List list;
+    auto append = [&](const extensions::ExtensionSet& set, bool enabled) {
+      for (const auto& extension : set) {
+        base::Value::Dict item;
+        item.Set("id", extension->id());
+        item.Set("name", extension->name());
+        item.Set("enabled", enabled);
+        list.Append(std::move(item));
+      }
+    };
+    append(registry->enabled_extensions(), true);
+    append(registry->disabled_extensions(), false);
+    append(registry->terminated_extensions(), false);
+    base::Value::Dict payload;
+    payload.Set("extensions", std::move(list));
+    ReplyTool(std::move(reply), id,
+              ToolContent(base::Value(std::move(payload))));
+    return;
+  }
+
+  if (name == "helium_set_extension_enabled") {
+    const std::string* ext_id = args.FindString("id");
+    const std::optional<bool> enabled = args.FindBool("enabled");
+    if (!ext_id || !enabled) {
+      ReplyTool(std::move(reply), id, ToolError("id and enabled required"));
+      return;
+    }
+    Profile* profile = ActiveProfile();
+    if (!profile) {
+      ReplyTool(std::move(reply), id, ToolError("no_profile"));
+      return;
+    }
+    auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+    if (*enabled) {
+      registrar->EnableExtension(*ext_id);
+    } else {
+      registrar->DisableExtension(
+          *ext_id, {extensions::disable_reason::DISABLE_USER_ACTION});
+    }
+    base::Value::Dict payload;
+    payload.Set("id", *ext_id);
+    payload.Set("enabled", *enabled);
+    ReplyTool(std::move(reply), id,
+              ToolContent(base::Value(std::move(payload))));
+    return;
+  }
+
+  if (name == "helium_set_request_intercept") {
+    const std::optional<int> tab_id = args.FindInt("tabId");
+    const std::optional<bool> enabled = args.FindBool("enabled");
+    if (!tab_id || !enabled) {
+      ReplyTool(std::move(reply), id, ToolError("tabId and enabled required"));
+      return;
+    }
+    std::optional<TabRef> tab = FindTab(*tab_id);
+    if (!tab) {
+      ReplyTool(std::move(reply), id, ToolError("unknown tab"));
+      return;
+    }
+    if (IsRestrictedUrl(tab->contents->GetLastCommittedURL())) {
+      ReplyTool(std::move(reply), id,
+                ToolError("attach_refused: restricted_url"));
+      return;
+    }
+    base::Value::Dict params;
+    if (*enabled) {
+      base::Value::List patterns;
+      base::Value::Dict pattern;
+      pattern.Set("urlPattern", "*");
+      patterns.Append(std::move(pattern));
+      params.Set("patterns", std::move(patterns));
+    }
+    DispatchCdp(
+        tab->contents, *enabled ? "Fetch.enable" : "Fetch.disable",
+        std::move(params),
+        base::BindOnce(
+            [](base::Value id, Reply reply, bool enabled, base::Value) {
+              base::Value::Dict payload;
+              payload.Set("enabled", enabled);
+              ReplyTool(std::move(reply), id,
+                        ToolContent(base::Value(std::move(payload))));
+            },
+            id.Clone(), std::move(reply), *enabled));
+    return;
+  }
+
+  ReplyTool(std::move(reply), id,
+            ToolError(base::StringPrintf("unknown tool: %s", name.c_str())));
+}
