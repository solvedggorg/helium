+bool IsRestrictedUrl(const GURL& url) {
+  if (!url.is_valid()) {
+    return true;
+  }
+  const std::string spec = url.spec();
+  if (spec == "about:blank" || spec == "about:srcdoc") {
+    return false;
+  }
+  return url.SchemeIs("chrome") || url.SchemeIs("helium") ||
+         url.SchemeIs("devtools") || url.SchemeIs("chrome-extension") ||
+         url.SchemeIs("about");
+}
+
+std::string WriteJson(const base::Value& value) {
+  std::string out;
+  base::JSONWriter::Write(value, &out);
+  return out;
+}
+
+base::Value::Dict RpcResult(const base::Value& id, base::Value result) {
+  base::Value::Dict out;
+  out.Set("jsonrpc", "2.0");
+  out.Set("id", id.Clone());
+  out.Set("result", std::move(result));
+  return out;
+}
+
+base::Value::Dict RpcError(const base::Value& id,
+                           int code,
+                           std::string_view message) {
+  base::Value::Dict err;
+  err.Set("code", code);
+  err.Set("message", message);
+  base::Value::Dict out;
+  out.Set("jsonrpc", "2.0");
+  out.Set("id", id.Clone());
+  out.Set("error", std::move(err));
+  return out;
+}
+
+base::Value::Dict ToolContent(const base::Value& payload) {
+  std::string text =
+      payload.is_string() ? payload.GetString() : WriteJson(payload);
+  base::Value::Dict item;
+  item.Set("type", "text");
+  item.Set("text", std::move(text));
+  base::Value::List content;
+  content.Append(std::move(item));
+  base::Value::Dict result;
+  result.Set("content", std::move(content));
+  return result;
+}
+
+base::Value::Dict ToolError(std::string_view message) {
+  base::Value::Dict item;
+  item.Set("type", "text");
+  item.Set("text", message);
+  base::Value::List content;
+  content.Append(std::move(item));
+  base::Value::Dict result;
+  result.Set("content", std::move(content));
+  result.Set("isError", true);
+  return result;
+}
+
+base::Value::Dict ToolDef(std::string_view name,
+                          std::string_view description,
+                          base::Value::Dict properties,
+                          base::Value::List required) {
+  base::Value::Dict schema;
+  schema.Set("type", "object");
+  schema.Set("properties", std::move(properties));
+  if (!required.empty()) {
+    schema.Set("required", std::move(required));
+  }
+  base::Value::Dict tool;
+  tool.Set("name", name);
+  tool.Set("description", description);
+  tool.Set("inputSchema", std::move(schema));
+  return tool;
+}
+
+base::Value::Dict StringProp(std::string_view description) {
+  base::Value::Dict p;
+  p.Set("type", "string");
+  p.Set("description", description);
+  return p;
+}
+
+base::Value::Dict IntProp(std::string_view description) {
+  base::Value::Dict p;
+  p.Set("type", "integer");
+  p.Set("description", description);
+  return p;
+}
+
+base::Value::Dict BoolProp(std::string_view description) {
+  base::Value::Dict p;
+  p.Set("type", "boolean");
+  p.Set("description", description);
+  return p;
+}
