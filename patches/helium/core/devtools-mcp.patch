+class HeliumMcpServer : public net::HttpServer::Delegate {
+ public:
+  HeliumMcpServer()
+      : session_id_(base::UnguessableToken::Create().ToString()) {}
+
+  void Start() {
+    auto socket =
+        std::make_unique<net::TCPServerSocket>(nullptr, net::NetLogSource());
+    const int rv = socket->ListenWithAddressAndPort(kBind, kMcpPort, 8);
+    if (rv != net::OK) {
+      LOG(ERROR) << "Helium MCP listen " << kBind << ":" << kMcpPort
+                 << " failed: " << net::ErrorToShortString(rv);
+      return;
+    }
+    server_ = std::make_unique<net::HttpServer>(std::move(socket), this);
+    LOG(INFO) << "Helium MCP listening on http://" << kBind << ":" << kMcpPort
+              << "/mcp";
+  }
+
+  void OnConnect(int connection_id) override {}
+
+  void OnHttpRequest(int connection_id,
+                     const net::HttpServerRequestInfo& info) override {
+    if (!info.peer.address().IsLoopback()) {
+      server_->Send404(connection_id, kTraffic);
+      return;
+    }
+    if (info.method == "OPTIONS") {
+      net::HttpServerResponseInfo response(net::HTTP_NO_CONTENT);
+      AddCors(&response);
+      server_->SendResponse(connection_id, response, kTraffic);
+      return;
+    }
+    const bool mcp_path =
+        info.path == "/mcp" || base::StartsWith(info.path, "/mcp?");
+    if (!mcp_path) {
+      server_->Send404(connection_id, kTraffic);
+      return;
+    }
+    if (info.method == "GET") {
+      SendJson(connection_id,
+               R"({"ok":true,"server":"helium-devtools","attachPath":"in-process"})");
+      return;
+    }
+    if (info.method != "POST") {
+      server_->Send404(connection_id, kTraffic);
+      return;
+    }
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &DispatchMcpOnUI, info.data,
+            base::BindPostTask(content::GetIOThreadTaskRunner({}),
+                               base::BindOnce(&HeliumMcpServer::OnRpcReady,
+                                              weak_factory_.GetWeakPtr(),
+                                              connection_id))));
+  }
+
+  void OnWebSocketRequest(int connection_id,
+                          const net::HttpServerRequestInfo& info) override {
+    server_->Close(connection_id);
+  }
+  void OnWebSocketMessage(int connection_id, std::string data) override {}
+  void OnClose(int connection_id) override {}
+
+ private:
+  void AddCors(net::HttpServerResponseInfo* response) {
+    response->AddHeader("Access-Control-Allow-Origin", "*");
+    response->AddHeader("Access-Control-Allow-Headers",
+                        "content-type, accept, mcp-session-id");
+    response->AddHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
+    response->AddHeader("mcp-session-id", session_id_);
+  }
+
+  void SendJson(int connection_id, std::string_view body) {
+    net::HttpServerResponseInfo response(net::HTTP_OK);
+    AddCors(&response);
+    response.SetBody(body, "application/json");
+    server_->SendResponse(connection_id, response, kTraffic);
+  }
+
+  void OnRpcReady(int connection_id, base::Value::Dict rpc) {
+    if (!server_) {
+      return;
+    }
+    if (rpc.empty()) {
+      net::HttpServerResponseInfo response(net::HTTP_ACCEPTED);
+      AddCors(&response);
+      server_->SendResponse(connection_id, response, kTraffic);
+      return;
+    }
+    SendJson(connection_id, WriteJson(base::Value(std::move(rpc))));
+  }
+
+  std::string session_id_;
+  std::unique_ptr<net::HttpServer> server_;
+  base::WeakPtrFactory<HeliumMcpServer> weak_factory_{this};
+};
+
+std::unique_ptr<HeliumMcpServer> g_server;
+
+}  // namespace
+
+void StartDevToolsMcp() {
+  content::GetIOThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce([] {
+                                                 if (g_server) {
+                                                   return;
+                                                 }
+                                                 g_server =
+                                                     std::make_unique<
+                                                         HeliumMcpServer>();
+                                                 g_server->Start();
+                                               }));
+}
+
+void StopDevToolsMcp() {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce([] { g_server.reset(); }));
+}
