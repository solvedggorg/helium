+struct TabRef {
+  raw_ptr<Browser> browser = nullptr;
+  raw_ptr<content::WebContents> contents = nullptr;
+  int index = -1;
+  int id = -1;
+};
+
+int TabIdFor(content::WebContents* contents) {
+  return sessions::SessionTabHelper::IdForTab(contents).id();
+}
+
+base::Value::Dict SerializeTab(content::WebContents* contents, bool active) {
+  base::Value::Dict tab;
+  tab.Set("id", TabIdFor(contents));
+  tab.Set("windowId", 0);
+  tab.Set("url", contents->GetLastCommittedURL().spec());
+  tab.Set("title", contents->GetTitle());
+  tab.Set("active", active);
+  tab.Set("status", contents->IsLoading() ? "loading" : "complete");
+  return tab;
+}
+
+std::optional<TabRef> FindTab(int tab_id) {
+  for (Browser* browser : *BrowserList::GetInstance()) {
+    TabStripModel* model = browser->tab_strip_model();
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      if (contents && TabIdFor(contents) == tab_id) {
+        return TabRef{browser, contents, i, tab_id};
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+base::Value::Dict ListTabsPayload() {
+  base::Value::List tabs;
+  int attached = 0;
+  for (Browser* browser : *BrowserList::GetInstance()) {
+    TabStripModel* model = browser->tab_strip_model();
+    const int active = model->active_index();
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      if (content::DevToolsAgentHost::IsDebuggerAttached(contents)) {
+        ++attached;
+      }
+      tabs.Append(SerializeTab(contents, i == active));
+    }
+  }
+  base::Value::Dict out;
+  out.Set("tabs", std::move(tabs));
+  out.Set("attachedCount", attached);
+  return out;
+}
